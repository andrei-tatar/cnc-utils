{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/*.wasm"
        ]
      },
      "cacheQueryOptions": { "ignoreSearch": true }
    },
    {
      "name": "templates",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/templates/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|png|ico|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**",
        "https://cdn.jsdelivr.net/**",
        "https://api.fontsource.org/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "365d"
      }
    }
  ]
}
