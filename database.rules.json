{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "projects": {
          "$project": {
            ".validate": "newData.hasChildren(['name', 'savedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "savedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "projectModels": {
          "$project": {
            ".validate": "newData.isString() && newData.val().length <= 10000000"
          }
        },
        "tools": {
          "$tool": {
            ".validate": "newData.hasChildren(['tool', 'savedAt'])",
            "tool": {
              ".validate": "newData.isString() && newData.val().length <= 100000"
            },
            "savedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
